  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
